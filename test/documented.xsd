<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture for XSD <annotation> handling. Documentation is legal on almost
  every component, and the ones below are the places it turns up in real
  schemas:

  * on the schema itself, documenting the document rather than any
    declaration in it, so there is nowhere to put it and it is dropped
  * on a named complexType, which does have a record to sit on
  * on an element declaration, which has a field
  * on a named group, and on the sequence inside one. Neither survives as
    anything of its own, so the text goes to the elements they contribute
  * on a named simpleType, which becomes a field's type rather than a record,
    so a field typed by it says what the type says
  * on an individual enumeration value, which is not a thing in the generated
    file at all, so it is listed under the field whose type it belongs to

  Where more than one applies, the most specific wins: what the element says
  itself, else what the group or sequence around it says, else what its type
  says.

  Deduped also declares the same element in two branches of a choice, one of
  them documented. Only one field can be emitted for it, so the text must not
  make the two look like different elements.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:d="http://example.com/documented"
           targetNamespace="http://example.com/documented"
           elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Version 1.0</xs:documentation>
  </xs:annotation>

  <xs:group name="OnTheGroup">
    <xs:annotation>
      <xs:documentation>What the group is for.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="inherits" type="xs:string"/>
      <xs:element name="overrides" type="xs:string">
        <xs:annotation>
          <xs:documentation>What this element is for.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:group>

  <xs:group name="OnTheSequence">
    <xs:sequence>
      <xs:annotation>
        <xs:documentation>What the sequence is for.</xs:documentation>
      </xs:annotation>
      <xs:element name="from_sequence" type="xs:string"/>
    </xs:sequence>
  </xs:group>

  <xs:simpleType name="Coded">
    <xs:annotation>
      <xs:documentation>What the simple type is for.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:maxLength value="3"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Status">
    <xs:restriction base="xs:string">
      <xs:enumeration value="open">
        <xs:annotation>
          <xs:documentation>What open means.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="closed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="Deduped" type="d:Deduped"/>
  <xs:complexType name="Deduped">
    <xs:choice>
      <xs:sequence>
        <xs:annotation>
          <xs:documentation>What the branch is for.</xs:documentation>
        </xs:annotation>
        <xs:element name="shared" type="xs:string"/>
      </xs:sequence>
      <xs:sequence>
        <xs:element name="shared" type="xs:string"/>
        <xs:element name="only_here" type="xs:string"/>
      </xs:sequence>
    </xs:choice>
  </xs:complexType>

  <xs:element name="Documented" type="d:Documented"/>
  <xs:complexType name="Documented">
    <xs:annotation>
      <xs:documentation>What the type is for.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="d:OnTheGroup"/>
      <xs:group ref="d:OnTheSequence"/>
      <xs:element name="plain" type="xs:string"/>
      <xs:element name="from_type" type="d:Coded"/>
      <xs:element name="status" type="d:Status"/>
      <xs:element name="beats_its_type" type="d:Coded">
        <xs:annotation>
          <xs:documentation>What this element is for.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
