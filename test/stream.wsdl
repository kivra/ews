<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:s="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="http://example.com/batch/service"
                  xmlns:b="http://example.com/schema/batch"
                  xmlns:it="http://example.com/schema/item"
                  targetNamespace="http://example.com/batch/service">
  <wsdl:types>
    <s:schema elementFormDefault="qualified"
              targetNamespace="http://example.com/schema/batch">
      <s:import namespace="http://example.com/schema/item" />
      <s:element name="Batch">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="BatchInfo"
                       type="b:BatchInfoType" />
            <s:element ref="it:Items" minOccurs="0" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:complexType name="BatchInfoType">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="Created"
                     type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="Source"
                     type="s:string" />
        </s:sequence>
      </s:complexType>
    </s:schema>
    <s:schema elementFormDefault="qualified"
              targetNamespace="http://example.com/schema/item">
      <s:element name="Items" type="it:ItemsType" />
      <s:complexType name="ItemsType">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="unbounded" name="Item"
                     type="it:ItemType" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="ItemType">
        <s:sequence>
          <s:element minOccurs="1" maxOccurs="1" name="Id" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="Name" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="Status"
                     type="it:StatusType" />
          <s:element minOccurs="0" maxOccurs="1" name="Note"
                     type="it:NoteType" />
        </s:sequence>
      </s:complexType>
      <s:simpleType name="StatusType">
        <s:restriction base="s:string">
          <s:enumeration value="ACTIVE" />
          <s:enumeration value="INACTIVE" />
        </s:restriction>
      </s:simpleType>
      <s:complexType name="NoteType">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="Text" type="s:string" />
        </s:sequence>
      </s:complexType>
    </s:schema>
  </wsdl:types>
  <wsdl:message name="ProcessSoapIn">
    <wsdl:part name="parameters" element="b:Batch" />
  </wsdl:message>
  <wsdl:message name="ProcessSoapOut">
    <wsdl:part name="parameters" element="b:Batch" />
  </wsdl:message>
  <wsdl:portType name="BatchServiceSoap">
    <wsdl:operation name="Process">
      <wsdl:input message="tns:ProcessSoapIn" />
      <wsdl:output message="tns:ProcessSoapOut" />
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="BatchServiceSoap" type="tns:BatchServiceSoap">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http" />
    <wsdl:operation name="Process">
      <soap:operation soapAction="http://example.com/batch/service/Process"
                      style="document" />
      <wsdl:input>
        <soap:body use="literal" />
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal" />
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="BatchService">
    <wsdl:port name="BatchServiceSoap" binding="tns:BatchServiceSoap">
      <soap:address location="http://example.com/batch/service" />
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
